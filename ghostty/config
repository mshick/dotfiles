font-family = Fira Code
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 14
font-feature = "-calt"

# shell-integration-features = sudo
shell-integration = fish

# Leading
adjust-cell-height = 35%

macos-option-as-alt = true
macos-titlebar-style = tabs
window-colorspace = display-p3
window-padding-balance = true
window-padding-x = 5
window-padding-y = 0
window-save-state = always

cursor-color = #607487
background = #252b37
background-opacity = 1
background-blur-radius = 20

mouse-hide-while-typing = true
mouse-shift-capture = true

# Cursor style
cursor-style = block
cursor-style-blink = false

# Clipboard settings
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true

# Theme
theme = Gruvbox Dark Hard

# Window variables
window-save-state = always

# Quick terminal toggle (Quake-style)
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.1

# Split navigation
keybind = cmd+shift+d=new_split:right
keybind = cmd+d=new_split:down
keybind = cmd+shift+left=goto_split:left
keybind = cmd+shift+right=goto_split:right
keybind = cmd+shift+up=goto_split:top
keybind = cmd+shift+down=goto_split:bottom
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits

# Claude Code shift+enter support
keybind = shift+enter=text:\n

# Bell notifications (for remote Claude alerts)
# system = macOS notification banner
# attention = dock icon bounce
# audio = play sound
bell-features = system,attention,audio
